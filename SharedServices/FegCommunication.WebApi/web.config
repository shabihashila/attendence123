<?xml version="1.0" encoding="utf-8"?>
<!-- Author: Md. Sakibur Rahman. Date: 2026-05-18. Removes IIS WebDAVModule
     so PUT / PATCH / DELETE / OPTIONS reach Kestrel, and pins
     ASPNETCORE_ENVIRONMENT=Production. The <aspNetCore> attributes are
     rewritten by `dotnet publish`; <environmentVariables> and the
     <modules>/<handlers> tweaks survive. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <remove name="aspNetCore" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\FegCommunication.WebApi.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
